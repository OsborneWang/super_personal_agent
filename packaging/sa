#!/bin/sh
# sa — super-agent Router session
#
# `sa` launches pi as the ROUTER of the super_personal_agent system:
# the file_ticket tool is available, tickets you confirm enter the daemon,
# and Workers execute them in the background.
#
# Plain `pi` stays a normal coding assistant with no task system.
#
# Usage:
#   sa [pi-args...]        interactive Router session (needs sa daemon running)
#   sa status              -> sa daemon status (systemd)
#   sa logs                -> sa daemon logs
#   sa ls / follow / ...   -> sa daemon CLI (see `agent --help`)
#
# Distinguish:
#   sa   = talk to the Router, work enters the super-agent system
#   pi   = plain coding assistant, nothing is scheduled or tracked

# Pass through daemon management / CLI convenience subcommands
case "$1" in
  start|stop|restart|status|logs|enable|disable|install|uninstall)
    exec agent daemon "$@"
    ;;
  ls|show|follow|answer|cancel|ping|test|init|reconcile)
    exec agent "$@"
    ;;
  -h|--help|help)
    sed -n '2,30p' "$0"
    exit 0
    ;;
esac

# Ensure the daemon is up; if not, offer to start it
if ! agent ping >/dev/null 2>&1; then
  echo "[sa] super-agent daemon is not running."
  printf "[sa] start it now via systemd? [Y/n] "
  read -r ans
  case "$ans" in
    n|N|no|NO)
      echo "[sa] aborted. Run 'sa start' first, or 'agent daemon' in a terminal."
      exit 1
      ;;
    *)
      agent daemon start || exit 1
      ;;
  esac
fi

# Mark this session as a super-agent Router session, then launch pi.
#
# Router tool restriction (design J1: Router 只分诊，绝不干活):
# The Router must NOT be able to execute the task itself. It only understands
# the request, drafts a ticket, asks you to confirm, and files it via
# file_ticket. So we strip every "doing" tool (bash/edit/write) and keep only
# read-only tools for understanding context + the file_ticket filing tool.
# Without this, the model tends to just do the work inline instead of routing.
export SA_MODE=1

# Router tool restriction (design J1: Router 是纯传话筒，绝不调查、绝不干活)。
# The Router's ONLY action is file_ticket. It does NOT read files, run commands,
# or investigate — all investigation belongs to background Workers. If a request
# is ambiguous, the Router asks YOU to clarify (dialogue), it does not go look
# things up itself. So the Router gets exactly ONE tool: file_ticket.
has_tools=0
for a in "$@"; do
  case "$a" in
    --tools|--tools=*)
      has_tools=1
      ;;
  esac
done

# Inject the Router role system-prompt so the model behaves as a dispatcher,
# not an assistant that answers/investigates inline.
SA_HOME="${SA_HOME:-/path/to/super_personal_agent}"
ROUTER_PROMPT="$SA_HOME/packaging/router-system-prompt.txt"

if [ "$has_tools" -eq 1 ]; then
  exec pi --append-system-prompt "$ROUTER_PROMPT" "$@"
else
  exec pi --append-system-prompt "$ROUTER_PROMPT" --tools file_ticket "$@"
fi
